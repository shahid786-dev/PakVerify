# ─────────────────────────────────────────────────────────────────────────────
# PakVerify backend environment variables
# Copy to backend/.env for local use, and add the same keys in
# Vercel → pakverify-api → Settings → Environment Variables for production.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ENV=production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,pakverify-api.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pakverify-ten.vercel.app
CSRF_TRUSTED_ORIGINS=https://pakverify-api.vercel.app,https://pakverify-ten.vercel.app
OTP_DEV_BYPASS=false

# Database (Neon PostgreSQL). Use the *pooled* connection string for Vercel.
# Neon console → project "pakverify" → Connect.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/pakverify_db?sslmode=require
DB_SSL_REQUIRE=true
DB_CONN_MAX_AGE=0

# File storage on Vercel (Vercel → Storage → Blob → create store, connect to project).
# Without it, uploads on Vercel are kept only temporarily in /tmp.
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=private

# Public URLs
FRONTEND_URL=https://pakverify-ten.vercel.app
CERTIFICATE_VERIFY_BASE_URL=https://pakverify-ten.vercel.app

# AI services
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=10
FACE_VERIFICATION_THRESHOLD=0.70
OPENAI_API_KEY=

# Email / SMS for OTP (if configured in users/otp_service.py)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Optional Ethereum anchoring with the PakVerifyRegistry contract (contracts/).
# Leave empty to keep the database-only ledger.
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_CHAIN_ID=11155111
ETH_CONTRACT_ADDRESS=
# Private key of a DEDICATED wallet that deployed the contract (testnet funds only).
ETH_PRIVATE_KEY=
ETH_EXPLORER_URL=https://sepolia.etherscan.io

# Local Docker only (ignored when DATABASE_URL is set)
# DB_TYPE=postgresql
# POSTGRES_DB=pakverify_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
